{
  "name": "mcu-timeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "validate:data": "node scripts/validate-data.mjs --legacy data/catalog.json",
    "validate:spec": "node scripts/validate-data.mjs --synthetic docs/specs/fixtures/catalog.synthetic.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:data && npm run validate:spec && npm test"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0"
  }
}
